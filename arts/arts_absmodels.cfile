Arts2 {

# This file contains standard choices for ARTS "continua".
# Focus is on more recent complete absorption models.

#
# Complete H2O absorption models (lines + continuum)
#

abs_cont_descriptionAppend( abs_cont_names,
                            abs_cont_models,
                            abs_cont_parameters,
                            "H2O-MPM89",
                            "MPM89",
                            [ ] )

abs_cont_descriptionAppend( abs_cont_names,
                            abs_cont_models,
                            abs_cont_parameters,
                            "H2O-MPM93",
                            "MPM93",
                            [ ] )

abs_cont_descriptionAppend( abs_cont_names,
                            abs_cont_models,
                            abs_cont_parameters,
                            "H2O-PWR98",
                            "Rosenkranz",
                            [ ] )



#
# H2O continua
#

# Rosenkranz-type H2O-H2O continuum:
abs_cont_descriptionAppend( abs_cont_names,
                            abs_cont_models,
                            abs_cont_parameters,
                            "H2O-SelfContStandardType",
                            "Rosenkranz",
                            [ ] )

# Rosenkranz-type H2O-dry air continuum:
abs_cont_descriptionAppend( abs_cont_names,
                            abs_cont_models,
                            abs_cont_parameters,
                            "H2O-ForeignContStandardType",
                            "Rosenkranz",
                            [ ] )

# Same for CKD MT 1.00
abs_cont_descriptionAppend( abs_cont_names,
                            abs_cont_models,
                            abs_cont_parameters,
                            "H2O-SelfContCKDMT100",
                            "CKDMT100",
                            [ ] )
abs_cont_descriptionAppend( abs_cont_names,
                            abs_cont_models,
                            abs_cont_parameters,
                            "H2O-ForeignContCKDMT100",
                            "CKDMT100",
                            [ ] )



#
# Full O2 absorption models (lines + continuum)
#

abs_cont_descriptionAppend( abs_cont_names,
                            abs_cont_models,
                            abs_cont_parameters,
                            "O2-MPM89",
                            "MPM89",
                            [ ] )

abs_cont_descriptionAppend( abs_cont_names,
                            abs_cont_models,
                            abs_cont_parameters,
                            "O2-MPM93",
                            "MPM93",
                            [ ] )

abs_cont_descriptionAppend( abs_cont_names,
                            abs_cont_models,
                            abs_cont_parameters,
                            "O2-PWR93",
                            "Rosenkranz",
                            [ ] )



#
# Standard O2-air continuum:
#

abs_cont_descriptionAppend( abs_cont_names,
                            abs_cont_models,
                            abs_cont_parameters,
                            "O2-SelfContStandardType",
                            "Rosenkranz",
                            [ ] )



#
# N2 continua
#

abs_cont_descriptionAppend( abs_cont_names,
                            abs_cont_models,
                            abs_cont_parameters,
                            "N2-SelfContStandardType",
                            "Rosenkranz",
                            [ ] )



#
# CO2 far line wing continuum from CKD F77 program:
#

abs_cont_descriptionAppend( abs_cont_names,
                            abs_cont_models,
                            abs_cont_parameters,
                            "CO2-CKDMT100",
                            "CKDMT100",
                            [ ] )

}
