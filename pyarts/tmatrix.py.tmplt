# This is the template file for pyarts_tmatrix.m

from PyARTS import arts_scat

scat_params={
    'ptype':$Q.PTYPE$,
    'equiv_radius':$Q.R$,
    'aspect_ratio':$Q.ARATIO$,
    'f_grid':[$Q.F$],
    'T_grid':[$Q.T$],
    'NP':$Q.SHAPE$,
    'phase':'$Q.WPHASE$',
    'za_grid':[$Q.ZA$],
    'aa_grid':[$Q.AA$]}

ssd = arts_scat.arts_types.SingleScatteringData(scat_params)
ssd.calc()
ssd.save('$Q.OUTFILE$')
